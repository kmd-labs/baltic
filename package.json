{
  "name": "baltic",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "test:i18n": "node --test --experimental-strip-types --no-warnings --import ./tests/ts-resolve.mjs tests/contract/content.test.ts",
    "build": "npm run test:i18n && ng build",
    "build:gh-pages": "npm run test:i18n && ng build --base-href /baltic/",
    "watch": "ng build --watch --configuration development",
    "setup:github": "node scripts/setup-github.mjs",
    "data:fetch": "python tools/data/fetch.py",
    "data:build": "npm run data:sources && npm run data:sills && npm run data:manifest && npm run validate && npm run assets:check",
    "data:build:grids": "python -m tools.data.postglacial",
    "data:build:rsl": "python -m tools.data.postglacial --rsl-only",
    "data:rsl-validation": "python -m tools.data.rsl_validation",
    "test:contract": "node --test --experimental-strip-types --no-warnings --import ./tests/ts-resolve.mjs \"tests/contract/*.test.ts\" && tsc -p tsconfig.contract.json",
    "test:data": "python -m unittest discover -s tools/data/tests -t .",
    "audit:metrics": "node --experimental-strip-types --no-warnings --import ./tests/ts-resolve.mjs tools/audit/metrics.ts",
    "assets:check": "node --experimental-strip-types --no-warnings --import ./tests/ts-resolve.mjs tools/assets/budget.ts",
    "validate": "node --experimental-strip-types --no-warnings --import ./tests/ts-resolve.mjs tools/validate/run.ts",
    "data:manifest": "node --experimental-strip-types --no-warnings --import ./tests/ts-resolve.mjs tools/manifest/build.ts",
    "data:sources": "node --experimental-strip-types --no-warnings --import ./tests/ts-resolve.mjs tools/sources/build.ts",
    "data:sills": "node --experimental-strip-types --no-warnings --import ./tests/ts-resolve.mjs tools/sills/build.ts",
    "contract:validate": "python tools/data/contract.py"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~21.2.0",
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/platform-browser-dynamic": "~21.2.0",
    "@angular/router": "~21.2.0",
    "d3-geo": "^3.1.1",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "three": "^0.184.0",
    "topojson-client": "^3.1.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@types/d3-geo": "^3.1.1",
    "@types/three": "^0.184.1",
    "@types/topojson-client": "^3.1.5",
    "typescript": "~5.9.0"
  }
}
