{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kmd-labs.github.io/baltic/contract/curve.schema.json",
  "title": "Curve — curves/<id>.json",
  "description": "Time series for the curves panel: rsl-sites (Rosentau 2021, clusters kept), esl (eustatic, display only), uplift, basin-metrics.",
  "type": "object",
  "required": ["schemaVersion", "id", "quantity", "unit", "datum", "series", "sources"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "enum": ["rsl-sites", "esl", "uplift", "basin-metrics"] },
    "quantity": { "$ref": "common.schema.json#/$defs/id" },
    "unit": { "enum": ["m", "mm/yr", "km2", "km3", "yr"] },
    "datum": { "$ref": "common.schema.json#/$defs/datum" },
    "readMethod": {
      "description": "How the values were obtained, e.g. read off a published table or figure (esl).",
      "type": "string"
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "points"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "cluster": { "type": "string" },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "points": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["tBP", "value"],
              "properties": {
                "tBP": { "$ref": "common.schema.json#/$defs/tBP" },
                "t14C": { "type": ["integer", "null"] },
                "value": { "type": "number" },
                "error": { "type": "number", "minimum": 0 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "sources": { "$ref": "common.schema.json#/$defs/sources" }
  },
  "additionalProperties": false
}
